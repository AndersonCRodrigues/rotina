# Copie este arquivo para ".env" e ajuste os valores antes de subir o projeto.

# Django
DEBUG=True
SECRET_KEY=troque-esta-chave-por-uma-gerada-com-django-get-random-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados (Postgres via docker-compose)
POSTGRES_DB=rotina
POSTGRES_USER=rotina
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Chave de criptografia simétrica (Fernet) para campos sensíveis (ex: notas de tarefas).
# Gere uma com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=troque-esta-chave-fernet

# Segurança de cookies/HTTPS (ative em produção atrás de HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
