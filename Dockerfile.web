# syntax=docker/dockerfile:1
FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev netcat-traditional \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . .

RUN ls -la /app/entrypoint.web.sh \
    && chmod +x /app/entrypoint.web.sh \
    && sed -i 's/\r$//' /app/entrypoint.web.sh

RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

ENTRYPOINT ["/app/entrypoint.web.sh"]
CMD ["gunicorn", "rotina.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3"]
