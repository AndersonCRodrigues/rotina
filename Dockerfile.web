# syntax=docker/dockerfile:1
FROM python:3.12-slim AS base

# Evita .pyc e garante logs em tempo real no `docker logs`
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# libpq-dev/gcc são necessários para compilar psycopg2 caso não haja wheel
# manylinux disponível para a arquitetura; netcat é usado pelo entrypoint
# para aguardar o Postgres ficar pronto.
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential libpq-dev netcat-traditional \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install -r requirements.txt

COPY . .

RUN chmod +x /app/entrypoint.web.sh

# Usuário não-root — evita rodar a aplicação como root dentro do container
RUN useradd --create-home appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

ENTRYPOINT ["/app/entrypoint.web.sh"]
CMD ["gunicorn", "rotina.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "3"]
